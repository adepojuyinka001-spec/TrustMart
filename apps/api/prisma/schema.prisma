// TrustMart schema.
// Phase 1 (Shared Core): identity/auth, RBAC, platform configuration, audit, consent, verification.
// Phase 2 (Marketplace Core): Category/Attribute Engine, Listing Engine, Buyer Request Engine, Matching Engine.
// Escrow, Rewards and Reviews entities are added in later, separately-approved phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile            Profile?
  businessStaff      BusinessStaff[]
  userRoles          UserRole[]
  consents           Consent[]
  whatsAppConsent    WhatsAppConsent?
  notificationPref   NotificationPreference?
  verificationCases  VerificationCase[]
  refreshTokens      RefreshToken[]
  auditEventsAsActor AuditEvent[]            @relation("ActorAuditEvents")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ---------- Business ----------

enum BusinessStaffRole {
  OWNER
  MANAGER
  MEMBER
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff             BusinessStaff[]
  verificationCases VerificationCase[]
}

model BusinessStaff {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessStaffRole @default(MEMBER)
  createdAt  DateTime          @default(now())

  @@unique([businessId, userId])
}

// ---------- RBAC ----------
// Roles/permissions are seeded data, not hard-coded checks. See src/modules/rbac.

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. BUYER, SELLER, ADMIN
  label       String
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. platform_config:write
  label       String
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ---------- Platform configuration ----------
// Generic typed config store so thresholds/pricing/lifecycle values are never hard-coded
// (CLAUDE.md SS4, SS6; seeded with SSOT defaults by the Shared Core seed script).

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformConfiguration {
  id          String          @id @default(cuid())
  key         String          @unique // e.g. marketplace.match_threshold_percent
  valueType   ConfigValueType
  value       String // serialized; parsed per valueType by the config service
  description String?
  version     Int             @default(1)
  updatedById String?
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())
}

// ---------- Audit ----------
// Every mutating Shared Core (and later, Marketplace/Escrow/Reward) action writes one of these.

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action       String // e.g. "platform_config.update"
  resourceType String
  resourceId   String?
  beforeState  Json?
  afterState   Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
}

// ---------- Consent / notification preferences ----------

enum ConsentType {
  MARKETING
  DATA_PROCESSING
  BUYER_CONTACT_SHARE
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@unique([userId, type])
}

model WhatsAppConsent {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optedIn    Boolean   @default(false)
  phone      String?
  optedInAt  DateTime?
  optedOutAt DateTime?
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  whatsAppEnabled Boolean @default(false)
  inAppEnabled    Boolean @default(true)
}

// ---------- Verification foundation ----------
// Provider-agnostic shell. No live KYC/KYB provider wired in (see OPEN_DECISIONS.md).

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum VerificationSubjectType {
  USER
  BUSINESS
}

model VerificationCase {
  id          String                  @id @default(cuid())
  subjectType VerificationSubjectType
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id])
  businessId  String?
  business    Business?               @relation(fields: [businessId], references: [id])
  status      VerificationStatus      @default(PENDING)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

// =========================================================================
// Marketplace Core (Phase 2): Category/Attribute Engine, Listing Engine,
// Buyer Request Engine, Matching Engine. Subscription/Contact/Escrow are
// separate, later phases (CLAUDE.md SS4; Marketplace Blueprint SS3).
//
// Simplifications vs. the Blueprint's full entity list, recorded in
// DECISION_LOG.md: listing/buyer-request lifecycle events reuse the
// existing generic AuditEvent instead of dedicated *LifecycleEvent tables;
// listing moderation reuses AuditEvent instead of a dedicated
// ListingModerationCase table; media/document storage is out of scope for
// this pass (no ListingMedia/ListingDocument yet).
// =========================================================================

// ---------- Category / Dynamic Attribute Engine ----------

enum AttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  MULTI_ENUM
}

model Category {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subcategories Subcategory[]
}

model Subcategory {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attributes       CategoryAttribute[]
  listings         Listing[]
  buyerRequests    BuyerRequest[]
  matchingProfiles MatchingProfile[]

  @@unique([categoryId, key])
}

// Admin-configurable attribute metadata (Blueprint SS6): key, label, data type,
// required/searchable/filterable/matchable/public live on CategoryAttribute
// (per-subcategory) since the same attribute definition can be required in one
// subcategory and optional in another.
model AttributeDefinition {
  id        String            @id @default(cuid())
  key       String            @unique
  label     String
  dataType  AttributeDataType
  unit      String?
  isPublic  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  options            AttributeOption[]
  categoryAttributes CategoryAttribute[]
  listingValues      ListingAttributeValue[]
  buyerRequirements  BuyerRequirement[]
  matchingCriteria   MatchingCriterion[]
}

model AttributeOption {
  id           String              @id @default(cuid())
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  label        String
  displayOrder Int                 @default(0)

  @@unique([attributeId, value])
}

model CategoryAttribute {
  id            String              @id @default(cuid())
  subcategoryId String
  subcategory   Subcategory         @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  attributeId   String
  attribute     AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  required      Boolean             @default(false)
  searchable    Boolean             @default(true)
  filterable    Boolean             @default(true)
  matchable     Boolean             @default(true)
  displayOrder  Int                 @default(0)

  @@unique([subcategoryId, attributeId])
}

// ---------- Listing Engine (seller inventory) ----------

enum ListingCondition {
  NEW
  USED
  REFURBISHED
  NOT_APPLICABLE
}

// DRAFT -> SUBMITTED -> CHECKING -> ACTIVE -> EXPIRING -> EXPIRED, plus
// SOLD / REJECTED / SUSPENDED / ARCHIVED (Blueprint SS12).
enum ListingStatus {
  DRAFT
  SUBMITTED
  CHECKING
  ACTIVE
  EXPIRING
  EXPIRED
  SOLD
  REJECTED
  SUSPENDED
  ARCHIVED
}

model Listing {
  id                    String           @id @default(cuid())
  sellerUserId          String
  businessId            String?
  subcategoryId         String
  subcategory           Subcategory      @relation(fields: [subcategoryId], references: [id])
  title                 String
  description           String
  askingPriceMinorUnits BigInt
  currency              String           @default("NGN")
  negotiable            Boolean          @default(false)
  condition             ListingCondition @default(NOT_APPLICABLE)
  country               String?
  state                 String?
  city                  String?
  quantity              Int              @default(1)
  status                ListingStatus    @default(DRAFT)
  moderationReason      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  activatedAt           DateTime?
  expiresAt             DateTime?
  soldAt                DateTime?

  attributeValues ListingAttributeValue[]
  priceHistory    ListingPriceHistory[]
  matches         Match[]
  savedBy         SavedListing[]
  interests       Interest[]

  @@index([subcategoryId, status])
  @@index([sellerUserId])
}

model ListingAttributeValue {
  id          String              @id @default(cuid())
  listingId   String
  listing     Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id])
  value       String // serialized; parsed per attribute.dataType

  @@unique([listingId, attributeId])
}

model ListingPriceHistory {
  id                      String   @id @default(cuid())
  listingId               String
  listing                 Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  previousPriceMinorUnits BigInt
  newPriceMinorUnits      BigInt
  changedAt               DateTime @default(now())
}

// ---------- Buyer Request Engine (buyer demand) ----------

enum BuyerRequestStatus {
  DRAFT
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum RequirementType {
  HARD
  PREFERRED
}

enum RequirementOperator {
  EQUALS
  NOT_EQUALS
  GT
  GTE
  LT
  LTE
  IN
  CONTAINS
}

// AI-parsed requests must be confirmed by the buyer before activation
// (CLAUDE.md SS11; Blueprint SS8) — enforced by requiring an explicit
// DRAFT -> ACTIVE transition through BuyerRequestService.activate().
model BuyerRequest {
  id                  String             @id @default(cuid())
  buyerUserId         String
  subcategoryId       String
  subcategory         Subcategory        @relation(fields: [subcategoryId], references: [id])
  minBudgetMinorUnits BigInt?
  maxBudgetMinorUnits BigInt?
  currency            String             @default("NGN")
  preferredLocations  Json? // string[] of city/state names
  quantity            Int                @default(1)
  timelineDays        Int?
  budgetFlexible      Boolean            @default(false)
  locationFlexible    Boolean            @default(false)
  status              BuyerRequestStatus @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  activatedAt         DateTime?

  requirements BuyerRequirement[]
  matches      Match[]

  @@index([subcategoryId, status])
  @@index([buyerUserId])
}

model BuyerRequirement {
  id              String              @id @default(cuid())
  buyerRequestId  String
  buyerRequest    BuyerRequest        @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)
  attributeId     String
  attribute       AttributeDefinition @relation(fields: [attributeId], references: [id])
  operator        RequirementOperator
  value           String // serialized; parsed per attribute.dataType
  requirementType RequirementType
  weightOverride  Float?

  @@unique([buyerRequestId, attributeId])
}

// ---------- Matching Engine ----------

enum MatchTriggerReason {
  LISTING_CREATED
  LISTING_ACTIVATED
  LISTING_PRICE_CHANGED
  BUYER_REQUEST_ACTIVATED
  BUYER_REQUEST_UPDATED
  MATCHING_PROFILE_CHANGED
  MANUAL_RECALCULATION
}

// A versioned, per-subcategory set of default attribute weights. Buyers may
// override an individual weight via BuyerRequirement.weightOverride.
model MatchingProfile {
  id                       String      @id @default(cuid())
  subcategoryId            String
  subcategory              Subcategory @relation(fields: [subcategoryId], references: [id])
  version                  Int         @default(1)
  isActive                 Boolean     @default(true)
  thresholdOverridePercent Float?
  createdAt                DateTime    @default(now())

  criteria MatchingCriterion[]
  matches  Match[]

  @@unique([subcategoryId, version])
}

model MatchingCriterion {
  id                String              @id @default(cuid())
  matchingProfileId String
  matchingProfile   MatchingProfile     @relation(fields: [matchingProfileId], references: [id], onDelete: Cascade)
  attributeId       String
  attribute         AttributeDefinition @relation(fields: [attributeId], references: [id])
  defaultWeight     Float

  @@unique([matchingProfileId, attributeId])
}

model MatchRun {
  id             String             @id @default(cuid())
  triggerReason  MatchTriggerReason
  listingId      String?
  buyerRequestId String?
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  matchesCreated Int                @default(0)

  matches Match[]
}

// One current Match row per (buyerRequest, listing) pair — recalculation
// upserts in place rather than accumulating history, matching Blueprint SS9's
// "recalculate on ..." triggers.
model Match {
  id                   String           @id @default(cuid())
  matchRunId           String
  matchRun             MatchRun         @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  buyerRequestId       String
  buyerRequest         BuyerRequest     @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)
  listingId            String
  listing              Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  matchingProfileId    String?
  matchingProfile      MatchingProfile? @relation(fields: [matchingProfileId], references: [id])
  thresholdUsedPercent Float
  scorePercent         Float
  qualified            Boolean
  hardFailed           Boolean
  hardFailureReason    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  criterionResults MatchCriterionResult[]
  interests        Interest[]

  @@unique([buyerRequestId, listingId])
  @@index([listingId])
}

model MatchCriterionResult {
  id                    String               @id @default(cuid())
  matchId               String
  match                 Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  criterionKey          String // attribute key, or built-in "BUDGET" / "LOCATION"
  requirementType       RequirementType
  operator              RequirementOperator?
  buyerValue            String?
  listingValue          String?
  weight                Float
  passed                Boolean
  criterionScorePercent Float?

  @@index([matchId])
}

// ---------- Engagement: Saved Listings, Interests, Contact Access, Leads ----------
// Blueprint SS10-11; CLAUDE.md SS11/SS13. "I'm Interested" creates an Interest and a Lead
// together. Contact access is gated on ALL of: subscription/entitlement (Subscription
// module is a later, separately-approved phase — until it exists, this check fails
// closed, so ContactAccessService.grantAccess() cannot currently succeed for anyone),
// buyer consent (reuses the existing Consent model, type BUYER_CONTACT_SHARE), a valid
// Interest/Lead context, server-side authorization (seller must own the listing), and an
// audit record of every attempt — granted or denied.

model SavedListing {
  id          String   @id @default(cuid())
  buyerUserId String
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([buyerUserId, listingId])
}

model Interest {
  id          String   @id @default(cuid())
  buyerUserId String
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id])
  message     String?
  createdAt   DateTime @default(now())

  lead Lead?

  @@unique([buyerUserId, listingId])
  @@index([listingId])
}

enum LeadStatus {
  NEW
  VIEWED
  CONTACTED
  INSPECTION_SCHEDULED
  NEGOTIATING
  TRANSACTION_STARTED
  WON
  LOST
  SPAM_FRAUD
}

// One Lead per Interest (Blueprint: Match -> Interest -> Lead -> Contact/Inspection ->
// Negotiation -> Transaction). SPAM_FRAUD is reachable only through a controlled
// moderation/risk action, never a normal buyer/seller transition.
model Lead {
  id           String   @id @default(cuid())
  interestId   String   @unique
  interest     Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  buyerUserId  String
  sellerUserId String
  listingId    String
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activities     LeadActivity[]
  contactGrants  ContactAccessGrant[]

  @@index([sellerUserId, status])
  @@index([buyerUserId])
}

model LeadActivity {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  actorUserId String
  note        String?
  createdAt   DateTime   @default(now())

  @@index([leadId])
}

// A record of every contact-access attempt on a Lead, granted or denied — the audit
// trail CLAUDE.md SS13 requires in addition to the generic AuditEvent log.
model ContactAccessGrant {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerUserId String
  granted      Boolean
  denialReason String?
  channel      String? // e.g. WHATSAPP, PHONE, EMAIL — only set when granted
  createdAt    DateTime @default(now())

  @@index([leadId])
}
