// TrustMart Shared Core schema.
// Scope: identity/auth, RBAC, platform configuration, audit, consent, verification.
// Marketplace, Escrow, Rewards and Reviews entities are added in later, separately-approved phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile             Profile?
  businessStaff       BusinessStaff[]
  userRoles           UserRole[]
  consents            Consent[]
  whatsAppConsent     WhatsAppConsent?
  notificationPref    NotificationPreference?
  verificationCases   VerificationCase[]
  refreshTokens       RefreshToken[]
  auditEventsAsActor  AuditEvent[]            @relation("ActorAuditEvents")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ---------- Business ----------

enum BusinessStaffRole {
  OWNER
  MANAGER
  MEMBER
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff             BusinessStaff[]
  verificationCases VerificationCase[]
}

model BusinessStaff {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessStaffRole @default(MEMBER)
  createdAt  DateTime          @default(now())

  @@unique([businessId, userId])
}

// ---------- RBAC ----------
// Roles/permissions are seeded data, not hard-coded checks. See src/modules/rbac.

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. BUYER, SELLER, ADMIN
  label       String
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. platform_config:write
  label       String
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ---------- Platform configuration ----------
// Generic typed config store so thresholds/pricing/lifecycle values are never hard-coded
// (CLAUDE.md SS4, SS6; seeded with SSOT defaults by the Shared Core seed script).

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformConfiguration {
  id          String          @id @default(cuid())
  key         String          @unique // e.g. marketplace.match_threshold_percent
  valueType   ConfigValueType
  value       String // serialized; parsed per valueType by the config service
  description String?
  version     Int             @default(1)
  updatedById String?
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())
}

// ---------- Audit ----------
// Every mutating Shared Core (and later, Marketplace/Escrow/Reward) action writes one of these.

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action       String // e.g. "platform_config.update"
  resourceType String
  resourceId   String?
  beforeState  Json?
  afterState   Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
}

// ---------- Consent / notification preferences ----------

enum ConsentType {
  MARKETING
  DATA_PROCESSING
  BUYER_CONTACT_SHARE
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@unique([userId, type])
}

model WhatsAppConsent {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optedIn    Boolean   @default(false)
  phone      String?
  optedInAt  DateTime?
  optedOutAt DateTime?
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  whatsAppEnabled Boolean @default(false)
  inAppEnabled    Boolean @default(true)
}

// ---------- Verification foundation ----------
// Provider-agnostic shell. No live KYC/KYB provider wired in (see OPEN_DECISIONS.md).

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum VerificationSubjectType {
  USER
  BUSINESS
}

model VerificationCase {
  id          String                  @id @default(cuid())
  subjectType VerificationSubjectType
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id])
  businessId  String?
  business    Business?               @relation(fields: [businessId], references: [id])
  status      VerificationStatus      @default(PENDING)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}
