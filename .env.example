# Copy to .env and fill in local values. Never commit the real .env (see .gitignore).
# All values below are for LOCAL DEVELOPMENT ONLY — no production secrets belong in this repo.

# --- apps/api ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://trustmart:trustmart_dev@localhost:5432/trustmart_dev?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-dev-only-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-dev-only-value
JWT_REFRESH_TTL=30d

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_APP_ORIGIN=http://localhost:3000

# --- docker-compose: postgres ---
POSTGRES_USER=trustmart
POSTGRES_PASSWORD=trustmart_dev
POSTGRES_DB=trustmart_dev

# --- docker-compose: n8n (self-hosted, local dev only) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-dev-only-password
